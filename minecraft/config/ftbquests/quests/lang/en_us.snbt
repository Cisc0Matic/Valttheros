	chapter_group.485E071B353FF153.title: "Valttheros"
	quest.B1A2C3D4E5F60101.quest_desc: [
		"La Tribu Barakoa te pone a prueba."
		"Elimina a los muertos cerca de la Guarida del Guardian (X=520 Z=530)."
		"Demuestra tu valor para ganarte su confianza."
	]
	quest.B1A2C3D4E5F60101.title: "El Primer Honor"
	quest.B1A2C3D4E5F60201.quest_desc: [
		"Tata Fawna necesita materiales sagrados."
		"Consigue un bloque de oro y arena del alma."
		"La Mascara de la Tribu te hara uno de ellos."
	]
	quest.B1A2C3D4E5F60201.title: "La Mascara Sagrada"
	quest.B1A2C3D4E5F60301.quest_desc: [
		"Los cultistas de la Llama amenazan la tribu."
		"Elimina a 10 warlocks para sellar la alianza."
		"La Tribu Barakoa luchara a tu lado."
	]
	quest.B1A2C3D4E5F60301.title: "Alianza de Sangre"
	quest.C2B3A4D5E6F70101.quest_desc: [
		"Necesitas infiltrarte en el Culto de la Llama."
		"Consigue un libro escribible para pasar como acolito."
		"Cuidado, los cultistas desconfian de todos."
	]
	quest.C2B3A4D5E6F70101.title: "Infiltracion"
	quest.C2B3A4D5E6F70201.quest_desc: [
		"El Tomo Infernal contiene los secretos del culto."
		"Recuperalo de las ruinas antes de que destruyan las pruebas."
		"Te servira para entender sus debilidades."
	]
	quest.C2B3A4D5E6F70201.title: "Robar el Tomo"
	quest.C2B3A4D5E6F70301.quest_desc: [
		"El Heresiarch es el lider del culto."
		"Derrotalo para poner fin a la amenaza oscura."
		"Es un boss dificil — prepareate bien."
	]
	quest.C2B3A4D5E6F70301.title: "Fin del Culto"
	quest.06429BA228A3C8E9.quest_desc: [
		"La Hinchada de River festeja en los Docks."
		"Necesitan pan para el asado post-partido."
		"16 panes y te invitan a la fiesta."
	]
	quest.06429BA228A3C8E9.title: "El Asado del Estadio"
	quest.0790B156143D25C6.quest_desc: [
		"Los Docks de Rosario hierven de actividad."
		"Coordenadas: X=300, Y=62, Z=-700."
		"El Rosarino Rebelde controla el puerto con mano dura."
	]
	quest.0790B156143D25C6.title: "Los Docks del Parana"
	quest.090129638DBA1C3C.quest_desc: [
		"La Fortaleza del Guardian custodia el norte."
		"Ubicada en X=1000, Y=70, Z=-300."
		"Derrota al Guardian del Azucar — un Golem de hierro — para avanzar."
	]
	quest.090129638DBA1C3C.title: "El Guardian del Azucar"
	quest.0F2DF91D51365D96.quest_desc: [
		"Bajo la Universidad yacen las Ruinas de la Cafeteria."
		"X=-820, Y=50, Z=620 — baja a las catacumbas."
		"Los Evokers del Profesor esperan ahi abajo."
	]
