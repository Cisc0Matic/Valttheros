	]
	quest.A6F7E8D9C0B10101.title: "Ritos Prohibidos"
	quest.A6F7E8D9C0B10201.quest_desc: [
		"El Innombrable quiere un libro de La Docta."
		"Busca en las ruinas subterraneas de Cordoba."
		"La Sombra siempre obtiene lo que quiere."
	]
	quest.A6F7E8D9C0B10201.title: "La Biblioteca Prohibida"
	quest.A6F7E8D9C0B10301.quest_desc: [
		"Los guardianes nocturnos protegen los secretos."
		"Elimina 3 de ellos para ganar acceso a La Sombra."
		"Los warlocks no sonNPCs de papel."
	]
	quest.A6F7E8D9C0B10301.title: "Los Guardianes de la Sombra"
	quest.B000000000000001.quest_desc: [
		"En Santiago del Estero, hasta los zombies laburan"
		"Conseguí arbustos muertos y mandalos al otro mundo"
	]
	quest.B000000000000001.quest_subtitle: "Los santiagueños no se rinden"
	quest.B000000000000001.title: "EH URA (Santiago del Estero)"
	quest.B000000000000002.quest_desc: [
		"Ponele un casco de cuero, boludo"
		"No es la moda más top, pero te salva del frío"
	]
	quest.B000000000000002.quest_subtitle: "En Tucumán hace frío... mentira, pero bueno"
	quest.B000000000000002.title: "TENGO FRIOO (Tucumán)"
	quest.B000000000000003.quest_desc: [
		"La verdadera dorada de Córdoba no es el sol"
		"Son las sandías que te ponen la cara toda brillante"
	]
	quest.B000000000000003.quest_subtitle: "¿Vos también venís de Córdoba?"
	quest.B000000000000003.title: "Che Boludo (Córdoba)"
	quest.B000000000000004.quest_desc: [
		"En Rosario el fútbol es sagrado"
		"Derrotá a los Pillagers como River le ganó a Boca... o al revés"
	]
	quest.B000000000000004.quest_subtitle: "El clásico más épico"
	quest.B000000000000004.title: "River vs Boca (Rosario)"
	quest.B000000000000005.quest_desc: [
		"Buenos Aires no para, y vos tampoco"
		"Conseguí pan como si fueras a un kiosco a las 3 de la mañana"
	]
	quest.B000000000000005.quest_subtitle: "El asfalto que nunca duerme"
	quest.B000000000000005.title: "La Avenida Corrientes (Buenos Aires)"
	quest.B1A2C3D4E5F60101.quest_desc: [
		"La Tribu Barakoa te pone a prueba."
		"Elimina a los muertos cerca de la Guarida del Guardian (X=520 Z=530)."
		"Demuestra tu valor para ganarte su confianza."
	]
	quest.B1A2C3D4E5F60101.title: "El Primer Honor"
	quest.B1A2C3D4E5F60201.quest_desc: [
		"Tata Fawna necesita materiales sagrados."
		"Consigue un bloque de oro y arena del alma."
		"La Mascara de la Tribu te hara uno de ellos."
	]
	quest.B1A2C3D4E5F60201.title: "La Mascara Sagrada"
	quest.B1A2C3D4E5F60301.quest_desc: [
		"Los cultistas de la Llama amenazan la tribu."
		"Elimina a 10 warlocks para sellar la alianza."
		"La Tribu Barakoa luchara a tu lado."
	]
	quest.B1A2C3D4E5F60301.title: "Alianza de Sangre"
	quest.B7A8F9E0D1C20101.quest_desc: [
		"El Capitan Duarte necesita peces y cueros."
		"Consigue 16 peces y 8 cueros de los docks."
		"El Parana no espera a los vagos."
	]
	quest.B7A8F9E0D1C20101.title: "Barco Cargado"
	quest.B7A8F9E0D1C20201.quest_desc: [
		"El Capitan Duarte quiere una emeralda como pago."
		"Dale 1 esmeralda al capitan de los docks."
		"El comercio fluvial es la vida de Rosario."
	]
	quest.B7A8F9E0D1C20201.title: "Pago al Capitan"
	quest.B7A8F9E0D1C20301.quest_desc: [
		"Los Mortifagos contaminan el Parana."
		"Elimina 3 drowned para limpiar el rio."
		"Los mercaderes te lo recompensaran."
	]
	quest.B7A8F9E0D1C20301.title: "Protegamos el Rio"
	quest.C2B3A4D5E6F70101.quest_desc: [
		"Necesitas infiltrarte en el Culto de la Llama."
		"Consigue un libro escribible para pasar como acolito."
		"Cuidado, los cultistas desconfian de todos."
	]
	quest.C2B3A4D5E6F70101.title: "Infiltracion"
	quest.C2B3A4D5E6F70201.quest_desc: [
		"El Tomo Infernal contiene los secretos del culto."
		"Recuperalo de las ruinas antes de que destruyan las pruebas."
		"Te servira para entender sus debilidades."
	]
	quest.C2B3A4D5E6F70201.title: "Robar el Tomo"
	quest.C2B3A4D5E6F70301.quest_desc: [
		"El Heresiarch es el lider del culto."
		"Derrotalo para poner fin a la amenaza oscura."
		"Es un boss dificil — prepareate bien."
	]
	quest.C2B3A4D5E6F70301.title: "Fin del Culto"
	quest.C8B9A0F1E2D30101.quest_desc: [
		"El Capitan Muerto quiere que hables con sus ancestros."
		"Busca 3 puntos en las islas del Parana."
		"Los muertos siempre tienen algo que decir."
	]
	quest.C8B9A0F1E2D30101.title: "Fantasmas del Pasado"
	quest.C8B9A0F1E2D30201.quest_desc: [
		"El Sacerdote del Rio necesita conchas nautilus."
		"Consigue 3 conchas del fondo del rio."
		"El rio guarda sus tesoros mas profundos."
	]
	quest.C8B9A0F1E2D30201.title: "Conchas del Fondo"
	quest.C8B9A0F1E2D30301.quest_desc: [
		"Los Mortifagos amenazan a los mercaderes."
		"Elimina 5 drowned para limpiar el rio."
		"Rosario no puede vivir sin el Parana."
	]
	quest.C8B9A0F1E2D30301.title: "Limpiemos el Rio"
	quest.D3C4B5A6F7E80101.quest_desc: [
		"Los agricultores de Tucuman necesitan semillas."
		"Consigue 3 semillas de trigo para las chacras del norte."
		"La cosecha depende de vos, boludo."
	]
	quest.D3C4B5A6F7E80101.title: "Siembra la Primera Semilla"
	quest.D3C4B5A6F7E80201.quest_desc: [
		"Los agricultores necesitan agua para el ritual."
		"Trae un cubo de agua y un bloque de heno."
		"Sin agua, no hay cosecha en el norte."
	]
	quest.D3C4B5A6F7E80201.title: "Ritual del Agua"
	quest.D3C4B5A6F7E80301.quest_desc: [
		"Las aranas de las cuevas destruyen las siembras."
		"Elimina 3 aranas de cueva para proteger las chacras."
		"Los del Norte no se rinden ante nada."
	]
	quest.D3C4B5A6F7E80301.title: "Ofrenda al Buen Cultivo"
	quest.D9C0B1A2F3E40101.quest_desc: [
		"El Comandante Vael necesita que patrulles Buenos Aires."
		"Visita 3 puntos de la ciudad para protegerla."
		"La Guardia Real es la ultima defensa."
	]
	quest.D9C0B1A2F3E40101.title: "Guardia de la Ciudad"
	quest.D9C0B1A2F3E40201.quest_desc: [
		"Los ciudadanos de Buenos Aires estan en peligro."
		"Derrota a cinco saqueadores que amenazan los caminos."
		"La ciudad nunca duerme, vos tampoco."
	]
	quest.D9C0B1A2F3E40201.title: "Protegemos a los Ciudadanos"
	quest.D9C0B1A2F3E40301.quest_desc: [
		"Los Invasores del Vacio son la mayor amenaza."
		"Elimina 5 enderman para defender Buenos Aires."
		"El vacio no tiene piedad, vos tampoco."
	]
	quest.D9C0B1A2F3E40301.title: "Invasores del Vacio"
	quest.E4D5C6B7A8F90101.quest_desc: [
		"El Sumo Sacerdote Ignes necesita obsidiana y crema de magma."
		"Consigue estos materiales para el altar del Fuego Interior."
		"El fuego siempre encuentra al que lo busca."
	]
	quest.E4D5C6B7A8F90101.title: "El Fuego Sagrado"
	quest.E4D5C6B7A8F90201.quest_desc: [
		"Los Guardianes de Llamas protegen el altar."
		"Elimina 5 de ellos para demostrar tu dominio del fuego."
		"El fuego interior te consumira si fallas."
	]
	quest.E4D5C6B7A8F90201.title: "Guardianes de Llamas"
	quest.E4D5C6B7A8F90301.quest_desc: [
		"El Sumo Sacerdote pide una ofrenda de pesca."
		"Consigue pescado fresco del rio para los antepasados."
		"Los muertos del fuego siempre recordaran tu sacrificio."
	]
	quest.E4D5C6B7A8F90301.title: "Agradecimiento a los Antepasados"
	quest.F5E6D7C8B9A00101.quest_desc: [
		"El Maestro Zenon necesita cafe de los bosques."
		"Consigue 8 granos de cafe para sus investigaciones."
		"La sabiduria viene con el cafe, boludo."
	]
	quest.F5E6D7C8B9A00101.title: "Cafe de la Docta"
	quest.F5E6D7C8B9A00201.quest_desc: [
		"La Aprendiz Valeria quiere que sobrevivas una noche sin luz."
		"Busca en las ruinas de La Docta sin usar antorchas."
		"Los sabios no tienen miedo a la oscuridad."
	]
